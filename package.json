{
  "name": "create-ai-project",
  "version": "1.28.0",
  "packageManager": "npm@12.0.2",
  "description": "Evidence-driven Claude Code workflows for TypeScript projects, from design and implementation through review and quality checks.",
  "keywords": [
    "typescript",
    "boilerplate",
    "template",
    "starter",
    "scaffolding",
    "cli",
    "claude-code",
    "anthropic",
    "ai-development",
    "llm-development",
    "skills",
    "sub-agents",
    "agentic",
    "workflow",
    "multi-agent"
  ],
  "author": "Shinsuke Kagawa",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinpr/ai-coding-project-boilerplate.git"
  },
  "bin": {
    "create-ai-project": "bin/create-project.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:backend": "tsc && tsc-alias",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "check:unused": "knip --include exports",
    "check:deps": "dpdm --no-warning --no-tree --exit-code circular:1 --ext .ts --exclude \"__tests__|.test.ts$|.spec.ts$\" --tsconfig ./tsconfig.json -T \"src/**/*.ts\"",
    "check:skills-index": "node scripts/check-skills-index.mjs",
    "check:code": "npm run check && npm run check:unused && npm run check:deps && npm run build",
    "check:all": "npm run check:code && npm run test",
    "cleanup:processes": "bash ./scripts/cleanup-test-processes.sh",
    "test:safe": "npm test && npm run cleanup:processes",
    "lang:ja": "node scripts/set-language.js ja",
    "lang:en": "node scripts/set-language.js en",
    "lang:status": "node scripts/set-language.js --status",
    "postinstall": "node scripts/set-language.js ja",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^24.13.3",
    "@vitest/ui": "^4.1.11",
    "dpdm": "^4.3.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
